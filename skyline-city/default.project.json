{
  "name": "SkylineCity",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ReplicatedFirst": {
      "Loading": {
        "$path": "src/first"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "ServerStorage": {
      "Assets": {
        "$className": "Folder",
        "Cars": { "$className": "Folder" },
        "Furniture": { "$className": "Folder" },
        "Buildings": { "$className": "Folder" },
        "NPCs": { "$className": "Folder" },
        "Clothing": { "$className": "Folder" }
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 120,
        "CharacterWalkSpeed": 16,
        "CharacterJumpPower": 50,
        "LoadCharacterAppearance": true
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts"
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 128,
        "StreamingTargetRadius": 512,
        "Gravity": 196.2
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Size": [4000, 4, 4000],
          "Position": [0, -2, 0],
          "Color": [0.30, 0.55, 0.28],
          "Material": "Grass",
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 9,
        "GeographicLatitude": 30,
        "Brightness": 2.5,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "GlobalShadows": true
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true
      }
    }
  }
}
