# Copy this file to .env and fill in what you use. Never share or commit .env.

# Telegram: message @BotFather → /newbot → paste the token here.
# Then send your bot any message and open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (optional): Channel settings → Integrations → Webhooks → Copy URL
DISCORD_WEBHOOK_URL=
