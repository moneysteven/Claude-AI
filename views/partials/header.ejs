<% if (typeof testMode !== "undefined" && testMode) { %>
  <div class="test-banner">Test mode: no real payments are taken. Orders are marked paid instantly so you can try the full flow.</div>
<% } %>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo"><%= siteName %></a>
    <nav>
      <a href="/">Shop</a>
      <a href="/cart" class="cart-link">
        Cart<% if (typeof cartCount !== "undefined" && cartCount > 0) { %>
          <span class="badge"><%= cartCount %></span>
        <% } %>
      </a>
    </nav>
  </div>
</header>
