<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="container confirmation-page">
  <% if (order.status === 'paid') { %>
    <h1>Thank you, <%= order.customer.name %>!</h1>
    <p>Your order <strong>#<%= order.id %></strong> has been received and paid.</p>
    <p>A receipt has been emailed to <strong><%= order.customer.email %></strong>.</p>
  <% } else { %>
    <h1>Order received</h1>
    <p>Your order <strong>#<%= order.id %></strong> is <%= order.status %>.</p>
    <p>We'll email you at <strong><%= order.customer.email %></strong> once payment is confirmed.</p>
  <% } %>

  <a href="/order/<%= order.id %>/receipt.pdf" class="btn-primary" target="_blank">View / Download Receipt</a>
  <a href="/" class="back-link">&larr; Continue shopping</a>
</main>

<%- include('partials/footer') %>
