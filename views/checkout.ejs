<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="container checkout-page">
  <h1>Checkout</h1>

  <% if (error) { %>
    <p class="error-banner"><%= error %></p>
  <% } %>

  <div class="checkout-grid">
    <form method="post" action="/checkout" class="checkout-form">
      <label>Full name<input type="text" name="name" required /></label>
      <label>Email<input type="email" name="email" required /></label>
      <label>Phone<input type="tel" name="phone" /></label>
      <label>Delivery address<textarea name="address" rows="3"></textarea></label>
      <button type="submit" class="btn-primary">Continue to Payment</button>
      <p class="fine-print">
        You'll be taken to our secure payment page to complete your purchase.
        Receipts are sent to your email automatically once payment is confirmed.
      </p>
    </form>

    <div class="order-summary">
      <h2>Order Summary</h2>
      <ul>
        <% cart.items.forEach(function(item) { %>
          <li><%= item.name %> &times; <%= item.quantity %> — JMD $<%= item.lineTotal.toLocaleString() %></li>
        <% }) %>
      </ul>
      <p class="cart-total">Total: JMD $<%= cart.total.toLocaleString() %></p>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
