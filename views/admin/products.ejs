<%- include('../partials/head') %>
<main class="container admin-page">
  <div class="admin-topbar">
    <h1>Manage Products</h1>
    <nav>
      <a href="/admin">&larr; Dashboard</a>
      <form method="post" action="/admin/logout"><button type="submit" class="link-button">Log out</button></form>
    </nav>
  </div>

  <h2>Add / Edit Product</h2>
  <form method="post" action="/admin/products" class="product-form">
    <label>Product ID (leave blank to create new)<input type="text" name="id" /></label>
    <label>Name<input type="text" name="name" required /></label>
    <label>Category<input type="text" name="category" required /></label>
    <label>Price (JMD)<input type="number" name="price" required min="0" /></label>
    <label>Stock<input type="number" name="stock" required min="0" /></label>
    <label>Image path<input type="text" name="image" placeholder="/img/placeholder-generic.svg" /></label>
    <label>Description<textarea name="description" rows="3" required></textarea></label>
    <button type="submit" class="btn-primary">Save Product</button>
  </form>

  <h2>Existing Products</h2>
  <table class="cart-table">
    <thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th></th></tr></thead>
    <tbody>
      <% products.forEach(function(p) { %>
        <tr>
          <td><%= p.name %> <small>(<%= p.id %>)</small></td>
          <td><%= p.category %></td>
          <td>JMD $<%= p.price.toLocaleString() %></td>
          <td><%= p.stock %></td>
          <td>
            <form method="post" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Delete this product?')">
              <button type="submit" class="link-button">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</main>
<%- include('../partials/footer') %>
