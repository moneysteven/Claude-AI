<%- include('../partials/head') %>
<main class="container admin-page">
  <div class="admin-topbar">
    <h1>Admin Dashboard</h1>
    <nav>
      <a href="/admin/products">Manage Products</a>
      <form method="post" action="/admin/logout"><button type="submit" class="link-button">Log out</button></form>
    </nav>
  </div>

  <div class="admin-stats">
    <div class="stat-card">
      <p class="stat-label">Total revenue (paid orders)</p>
      <p class="stat-value">JMD $<%= totalRevenue.toLocaleString() %></p>
    </div>
    <div class="stat-card">
      <p class="stat-label">Total orders</p>
      <p class="stat-value"><%= orders.length %></p>
    </div>
    <div class="stat-card">
      <p class="stat-label">Products in catalog</p>
      <p class="stat-value"><%= products.length %></p>
    </div>
  </div>

  <h2>Orders</h2>
  <table class="cart-table">
    <thead>
      <tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th><th></th></tr>
    </thead>
    <tbody>
      <% orders.forEach(function(o) { %>
        <tr>
          <td>#<%= o.id %></td>
          <td><%= o.customer.name %><br/><small><%= o.customer.email %></small></td>
          <td>JMD $<%= o.total.toLocaleString() %></td>
          <td><span class="status-pill status-<%= o.status %>"><%= o.status %></span></td>
          <td><%= new Date(o.createdAt).toLocaleString() %></td>
          <td><a href="/order/<%= o.id %>/receipt.pdf" target="_blank">Receipt</a></td>
        </tr>
      <% }) %>
      <% if (orders.length === 0) { %>
        <tr><td colspan="6">No orders yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</main>
<%- include('../partials/footer') %>
