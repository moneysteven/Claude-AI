<%- include('../partials/head') %>
<main class="container admin-page">
  <div class="admin-topbar">
    <h1>Admin Dashboard</h1>
    <nav>
      <a href="/admin/products">Manage Products</a>
      <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button type="submit" class="link-button">Log out</button></form>
    </nav>
  </div>

  <div class="admin-stats">
    <div class="stat-card">
      <p class="stat-label">Revenue (real paid orders)</p>
      <p class="stat-value">JMD $<%= totalRevenue.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></p>
    </div>
    <div class="stat-card">
      <p class="stat-label">Total orders</p>
      <p class="stat-value"><%= orders.length %></p>
      <% if (testOrders) { %><p class="stat-label"><%= testOrders %> test order<%= testOrders === 1 ? '' : 's' %> (not counted in revenue)</p><% } %>
    </div>
    <div class="stat-card">
      <p class="stat-label">Products in catalog</p>
      <p class="stat-value"><%= products.length %></p>
    </div>
  </div>

  <h2>Orders</h2>
  <table class="cart-table">
    <thead>
      <tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th><th></th></tr>
    </thead>
    <tbody>
      <% orders.forEach(function(o) { %>
        <tr>
          <td>#<%= o.id %></td>
          <td><%= o.customer.name %><br/><small><%= o.customer.email %></small></td>
          <td>JMD $<%= Number(o.total).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
          <td><span class="status-pill status-<%= o.status %>"><%= o.status %></span><% if (o.testMode) { %> <span class="status-pill status-test">test</span><% } %><% if (o.reviewReason) { %><br/><small><%= o.reviewReason %></small><% } %><% if (o.receiptError) { %><br/><small>Receipt email failed</small><% } %></td>
          <td><%= new Date(o.createdAt).toLocaleString() %></td>
          <td><a href="/order/<%= o.id %>/receipt.pdf" target="_blank">Receipt</a></td>
        </tr>
      <% }) %>
      <% if (orders.length === 0) { %>
        <tr><td colspan="6">No orders yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</main>
<%- include('../partials/footer') %>
