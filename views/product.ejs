<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="container product-detail">
  <a href="/" class="back-link">&larr; Back to shop</a>
  <div class="product-detail-grid">
    <img src="<%= product.image %>" alt="<%= product.name %>" />
    <div>
      <h1><%= product.name %></h1>
      <p class="category-tag"><%= product.category %></p>
      <p class="price-large">JMD $<%= product.price.toLocaleString() %></p>
      <p class="description"><%= product.description %></p>
      <p class="stock <%= product.stock === 0 ? 'out' : '' %>">
        <%= product.stock === 0 ? 'Out of stock' : product.stock + ' in stock' %>
      </p>
      <form method="post" action="/cart/add" class="add-to-cart-form">
        <input type="hidden" name="productId" value="<%= product.id %>" />
        <label>
          Quantity:
          <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>" />
        </label>
        <button type="submit" <%= product.stock === 0 ? 'disabled' : '' %>>Add to cart</button>
      </form>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
