<%- include("partials/head", { useMap: true }) %>
<%- include("partials/header") %>
<h1>Buses</h1>
<div id="map" class="map"></div>

<div class="bus-cards">
  <% buses.forEach((b) => { %>
    <div class="card">
      <h2><%= b.number %> · <%= b.name %></h2>
      <p class="muted"><%= b.plate %> · <%= b.description %><br />Driver: <%= b.driverName %>, <%= b.driverPhone %><br /><%= b.riders %> students · <%= b.stops.length %> stops</p>
      <p><% if (b.trip) { %><span class="dot live"></span> On the road – <%= b.trip.direction %> run<% } else { %><span class="dot"></span> Not running<% } %></p>
      <p class="small">Driver's link (open on the driver's phone):<br />
        <input class="copy" readonly value="<%= baseUrl %>/driver/<%= b.driverToken %>" onclick="this.select()" />
      </p>
      <p class="small">Door scanner link (open on the phone/tablet fixed at the bus door):<br />
        <input class="copy" readonly value="<%= baseUrl %>/scan/<%= b.scannerToken %>" onclick="this.select()" />
      </p>
      <a class="btn small secondary" href="/driver/<%= b.driverToken %>" target="_blank">Open driver page</a>
      <a class="btn small secondary" href="/scan/<%= b.scannerToken %>" target="_blank">Open door scanner</a>
    </div>
  <% }) %>
</div>
<p class="muted">Parents get their own tracking link from the <a href="/students">Students</a> page.</p>

<script>
  // All buses on one map (Google Maps or OpenStreetMap — see map-kit.js).
  (async function () {
    const kit = await MapKit.create(document.getElementById("map"));
    const colors = ["#1a73e8", "#ff9500", "#af52de", "#ff2d55"];
    const markers = {};
    let fitted = false;

    async function refresh() {
      const buses = await fetch("/buses.json").then((r) => r.json());
      const all = [];
      buses.forEach((b, i) => {
        const route = b.route.map(([lat, lng]) => ({ lat, lng }));
        if (!markers[b.id]) {
          kit.polyline(route, { color: colors[i % colors.length], weight: 5, opacity: 0.7 });
          b.stops.forEach((s) => kit.dot(s, { color: colors[i % colors.length], label: `${b.name}: ${s.name}` }));
          markers[b.id] = kit.bus();
        }
        all.push(...route);
        markers[b.id].set(b.location ? { lat: b.location.lat, lng: b.location.lng } : null);
      });
      if (!fitted && all.length) { kit.fit(all); fitted = true; }
    }
    refresh();
    setInterval(refresh, 5000);
  })();
</script>
<%- include("partials/footer") %>
