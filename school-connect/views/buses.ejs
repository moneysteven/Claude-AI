<%- include("partials/head", { useMap: true }) %>
<%- include("partials/header") %>
<h1>Buses</h1>
<div id="map" class="map"></div>

<div class="bus-cards">
  <% buses.forEach((b) => { %>
    <div class="card">
      <h2><%= b.number %> · <%= b.name %></h2>
      <p class="muted"><%= b.plate %> · <%= b.description %><br />Driver: <%= b.driverName %>, <%= b.driverPhone %><br /><%= b.riders %> students · <%= b.stops.length %> stops</p>
      <p><% if (b.trip) { %><span class="dot live"></span> On the road – <%= b.trip.direction %> run<% } else { %><span class="dot"></span> Not running<% } %></p>
      <p class="small">Driver's link (open on the driver's phone):<br />
        <input class="copy" readonly value="<%= baseUrl %>/driver/<%= b.driverToken %>" onclick="this.select()" />
      </p>
      <p class="small">Door scanner link (open on the phone/tablet fixed at the bus door):<br />
        <input class="copy" readonly value="<%= baseUrl %>/scan/<%= b.scannerToken %>" onclick="this.select()" />
      </p>
      <a class="btn small secondary" href="/driver/<%= b.driverToken %>" target="_blank">Open driver page</a>
      <a class="btn small secondary" href="/scan/<%= b.scannerToken %>" target="_blank">Open door scanner</a>
    </div>
  <% }) %>
</div>
<p class="muted">Parents get their own tracking link from the <a href="/students">Students</a> page.</p>

<script>
  const map = L.map("map").setView([18.0, -76.82], 12);
  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: "&copy; OpenStreetMap contributors",
  }).addTo(map);
  const colors = ["#007aff", "#ff9500", "#af52de", "#ff2d55"];
  const markers = {};
  let fitted = false;

  async function refresh() {
    const buses = await fetch("/buses.json").then((r) => r.json());
    const bounds = [];
    buses.forEach((b, i) => {
      const color = colors[i % colors.length];
      if (!markers[b.id]) {
        L.polyline(b.route, { color, weight: 4, opacity: 0.6 }).addTo(map);
        b.stops.forEach((s) => L.circleMarker([s.lat, s.lng], { radius: 5, color }).addTo(map).bindTooltip(`${b.name}: ${s.name}`));
        markers[b.id] = L.marker(b.route[0], { icon: L.divIcon({ className: "bus-icon", html: "<span class=\"busdot\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"4.5\" y=\"3\" width=\"15\" height=\"15\" rx=\"3.2\"/><path d=\"M4.5 11h15M8 21v-3M16 21v-3\"/></svg></span>", iconSize: [36, 36] }) }).bindTooltip(b.name);
      }
      bounds.push(...b.route);
      if (b.location) markers[b.id].setLatLng([b.location.lat, b.location.lng]).addTo(map);
      else markers[b.id].remove();
    });
    if (!fitted && bounds.length) { map.fitBounds(bounds, { padding: [20, 20] }); fitted = true; }
  }
  refresh();
  setInterval(refresh, 5000);
</script>
<%- include("partials/footer") %>
