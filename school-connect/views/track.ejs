<%- include("partials/head", { useMap: true }) %>
<header class="site-header slim"><div class="container header-inner"><span class="logo"><%= schoolName %> <span>Bus tracker</span></span></div></header>
<main class="container narrow track" id="track" data-token="<%= token %>">
  <div id="leave-banner" class="leave-banner" hidden>
    <strong>Time to leave</strong>
    <span id="leave-text"></span>
  </div>

  <div class="card where" id="where" hidden>
    <div id="where-ask">
      <h2>Where do you catch the bus?</h2>
      <p class="muted small">Set your spot and the app finds your pickup point on the bus route — the nearest point to you.</p>
      <div class="where-btns">
        <button class="btn" id="where-gps">Use my location</button>
        <button class="btn secondary" id="where-tap">Tap the map</button>
      </div>
    </div>
    <div id="where-set" class="where-set" hidden>
      <span class="mk-me"></span>
      <div><strong>Your pickup point</strong><br /><span class="muted small" id="where-walk"></span></div>
      <button class="btn small secondary" id="where-change">Change</button>
    </div>
    <p class="small where-msg" id="where-msg"></p>
  </div>

  <div class="card status-card">
    <div id="headline" class="headline">Loading…</div>
    <div id="subline" class="muted"></div>
    <div id="children" class="children"></div>
  </div>

  <div id="map" class="map"></div>

  <div class="card bus-info" id="bus-info" hidden>
    <h2>Your child's bus</h2>
    <dl>
      <dt>Bus</dt><dd id="bi-number"></dd>
      <dt>Plate</dt><dd id="bi-plate"></dd>
      <dt>Looks like</dt><dd id="bi-desc"></dd>
      <dt>Route</dt><dd id="bi-route"></dd>
      <dt>Your stop</dt><dd id="bi-stop"></dd>
      <dt>Driver</dt><dd id="bi-driver"></dd>
      <dt>Driver's phone</dt><dd><a id="bi-phone" href="#"></a></dd>
    </dl>
    <p class="muted small">Please don't call the driver while the bus is moving unless it's urgent. For anything else, call the school.</p>
  </div>

  <div class="card">
    <div class="zone-head">
      <h2>Alert zone</h2>
      <button class="btn small secondary" id="zone-reset" hidden>Back to my stop</button>
    </div>
    <label for="radius">Text me when the bus is within <strong id="radius-label"></strong></label>
    <input type="range" id="radius" class="range" min="0" max="1000" step="1" aria-describedby="radius-hint" />
    <div class="range-ticks"><span><%= radiusMin %> m</span><span>1 km</span><span><%= radiusMax / 1000 %> km</span></div>
    <p class="muted small" id="radius-hint"></p>
    <p class="muted small">Drag the orange circle on the map to move your zone — for example further back along the route for an earlier warning. Drag its edge to make it bigger or smaller. You'll get a text the moment the bus enters it.</p>
    <button class="btn secondary" id="enable-notify">Also alert me on this phone</button>
  </div>
</main>
<script src="/js/track.js"></script>
</body>
</html>
