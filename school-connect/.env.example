# --- School details (shown in every message parents receive) ---
SCHOOL_NAME=Demo High School
SCHOOL_PHONE=876-555-0100

# --- Staff login ---
STAFF_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string

# The public address of this app. Used to build the tracking links that are
# texted to parents, e.g. https://schoolconnect.example.com
PUBLIC_URL=http://localhost:3000

# --- Messaging ---
# "test" = nothing is really sent; every message appears on the Messages page.
# "twilio" = real SMS / WhatsApp through Twilio.
MESSAGING_PROVIDER=test
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio SMS number, e.g. +18765550123
TWILIO_SMS_FROM=
# Your approved WhatsApp sender, e.g. +18765550123
TWILIO_WHATSAPP_FROM=

# --- Lunch system integration ---
# Your kitchen/lunch system calls POST /api/lunch/collected with this key in
# the x-api-key header whenever a student receives lunch.
LUNCH_API_KEY=replace-with-a-long-random-string

# --- SBA tracking ---
# A student counts as "behind" when an SBA is not submitted and is due
# within this many days (or is already overdue).
SBA_WARNING_DAYS=14
