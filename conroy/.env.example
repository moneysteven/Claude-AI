# =====================================================================
# Conroy AI Receptionist - environment variables
# Copy to .env and fill in. NEVER commit .env. Every secret lives here
# (or in the encrypted per-business columns), never in code or logs.
# Generate random values with:  openssl rand -base64 32
# =====================================================================

# ---------- Core ----------
# development | production | test
NODE_ENV=development
# Public base URL of this app (no trailing slash). Used to build webhook URLs,
# the widget snippet and links in WhatsApp summaries. https:// in production.
APP_URL=http://localhost:3000
# Port the Next.js server listens on.
PORT=3000
# PostgreSQL connection string.
DATABASE_URL=postgresql://conroy:conroy_dev@localhost:5432/conroy
# Separate database used by the integration tests (it is wiped on every run).
DATABASE_URL_TEST=postgresql://conroy:conroy_dev@localhost:5432/conroy_test
# 32+ random characters. Signs dashboard session tokens and widget chat tokens.
SESSION_SECRET=
# Base64 of exactly 32 random bytes (openssl rand -base64 32). AES-256-GCM key
# for transcripts, message bodies, recordings links and provider credentials.
# Losing it makes that data unreadable; rotating it needs a re-encryption run.
DATA_ENCRYPTION_KEY=
# trace | debug | info | warn | error
LOG_LEVEL=info
# Area code added to 7-digit local numbers (876 or 658).
DEFAULT_AREA_CODE=876

# ---------- Error alerts (email) ----------
# Where error alerts are sent (Steven's inbox). Leave blank to disable emails.
ALERT_EMAIL=
# Any SMTP account (Gmail app password, Zoho, your host's mailbox...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address for alert emails.
SMTP_FROM="Conroy Alerts <alerts@example.com>"

# ---------- Chat LLM (WhatsApp + web widget) ----------
# anthropic | openai | rules   ("rules" = no LLM, keyword answers only; good for demos/tests)
LLM_PROVIDER=rules
# Small, cheap default model. For openai use e.g. gpt-5.4-mini.
LLM_MODEL=claude-haiku-5-5
# Anthropic API key (when LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
# OpenAI (or any OpenAI-compatible API) key and base URL (when LLM_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Max tool-call rounds per customer message (safety limit).
LLM_MAX_TOOL_ROUNDS=6

# ---------- Voice: Retell AI ----------
# Retell API key (dashboard > API Keys). Used by scripts/retell-sync.ts and to
# verify Retell webhook signatures.
RETELL_API_KEY=
# Optional: a different Retell key that carries the "webhook" badge. If blank,
# RETELL_API_KEY is used to verify x-retell-signature.
RETELL_WEBHOOK_KEY=
# Random string sent by Retell as the X-Conroy-Function-Secret header on custom
# function calls (defence in depth on top of the signature).
RETELL_FUNCTION_SECRET=
# Model Retell uses on calls (see Retell docs for the list).
RETELL_LLM_MODEL=claude-5.5-haiku
# Retell voice id (pick a warm Caribbean/neutral English voice in the dashboard).
RETELL_VOICE_ID=11labs-Adrian
# Set to false to skip Retell signature checks in local development ONLY.
RETELL_VERIFY_SIGNATURES=true

# ---------- Telephony: SIP trunk for the +1 876 number ----------
# twilio | telnyx
TELEPHONY_PROVIDER=twilio
# Termination URI of your SIP trunk (Twilio: xxx.pstn.twilio.com; Telnyx: sip.telnyx.com).
SIP_TERMINATION_URI=
# Credentials Retell uses to place outbound legs (transfers) on your trunk.
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
# Twilio auth token: verifies X-Twilio-Signature on Twilio status webhooks.
TWILIO_AUTH_TOKEN=
# Telnyx public key (base64, from Mission Control > Keys): verifies Ed25519 webhook signatures.
TELNYX_PUBLIC_KEY=

# ---------- WhatsApp ----------
# Default provider for new businesses: console (logs only, for dev) | meta | 360dialog
WHATSAPP_PROVIDER=console
# Meta WhatsApp Cloud API: permanent System User access token.
META_WA_ACCESS_TOKEN=
# Meta app secret: verifies X-Hub-Signature-256 on incoming webhooks.
META_WA_APP_SECRET=
# Any random string; paste the same value as "Verify token" in the Meta webhook settings.
META_WA_VERIFY_TOKEN=
# Graph API version.
META_WA_API_VERSION=v23.0
# 360dialog API key (only when using 360dialog).
DIALOG360_API_KEY=
# 360dialog base URL.
DIALOG360_BASE_URL=https://waba-v2.360dialog.io
# Random token appended to the 360dialog webhook URL (?token=...). 360dialog does
# not sign webhooks, so this shared secret authenticates them.
DIALOG360_WEBHOOK_TOKEN=

# ---------- Calendar ----------
# Google service account used to read/write the calendars businesses share with it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service-account JSON (keep the \n escapes, wrap in quotes).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Cal.com API base URL (per-business Cal.com API keys are stored encrypted in the DB).
CALCOM_API_BASE_URL=https://api.cal.com/v2

# ---------- Jobs ----------
# Set to false on a web-only replica so it never runs scheduled jobs.
JOBS_ENABLED=true

# ---------- Seed (demo data) ----------
# Dashboard login for the demo salon owner.
SEED_OWNER_EMAIL=tasha@example.com
# Password for the demo owner (min 10 chars). Required to run the seed.
SEED_OWNER_PASSWORD=
# Optional super-admin account for Steven Scale Solutions.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
