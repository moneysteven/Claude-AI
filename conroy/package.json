{
  "name": "conroy-ai-receptionist",
  "version": "0.1.0",
  "private": true,
  "description": "Conroy - multi-tenant AI receptionist (voice, WhatsApp, web chat, booking) for Jamaican small businesses. By Steven Scale Solutions.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev -p ${PORT:-3000}\" \"tsx watch src/worker.ts\"",
    "dev:web": "next dev -p ${PORT:-3000}",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "retell:sync": "tsx scripts/retell-sync.ts",
    "postinstall": "prisma generate",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:e2e": "playwright test --trace off"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@prisma/client": "^6.19.3",
    "luxon": "^3.7.2",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "pg-boss": "^10.4.2",
    "pino": "^9.14.0",
    "prisma": "^6.19.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "retell-sdk": "^6.2.19",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
