# ---------------------------------------------------------------
# Selfie TV Boss Entertainment — settings
# Copy this file to `.env` and fill in your real values.
# NEVER share or commit your real .env file.
# ---------------------------------------------------------------

PORT=3000

# The public web address of this app. Twilio uses it to fetch call
# instructions and your voice recordings.
#  - While testing on your computer: the https URL ngrok gives you
#  - Once deployed: https://selfietvboss.com (or your Render URL)
PUBLIC_URL=https://your-ngrok-or-render-url.example.com

# --- Admin dashboard (/admin) — CHANGE THESE ---
ADMIN_USER=boss
ADMIN_PASSWORD=change-me-now

# --- Twilio (from https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# The Twilio number the calls come FROM (E.164 format, e.g. +18765551234)
TWILIO_PHONE_NUMBER=+10000000000
# Check that call requests really come from Twilio. Leave "true" in production.
TWILIO_VALIDATE_REQUESTS=true

# --- Your own phone ---
# "Press 0 to speak to Selfie TV Boss" forwards here, and new leads /
# bookings are texted here.
OWNER_PHONE=+18760000000
SMS_NOTIFY_OWNER=true
# Type out callers' spoken answers so you can read them in /admin
# (Twilio charges about US$0.05 per minute transcribed).
TRANSCRIBE_ANSWERS=true

# --- Calling rules ---
# Numbers written without a country code get this one (1 = Jamaica/US/Canada)
DEFAULT_COUNTRY_CODE=1
TIMEZONE=America/Jamaica
# Only place calls between these hours (24h clock, local TIMEZONE)
CALL_START_HOUR=9
CALL_END_HOUR=19
# Days calls are allowed: 0=Sun 1=Mon ... 6=Sat
CALL_DAYS=1,2,3,4,5,6
# Seconds to wait between outgoing calls
CALL_DELAY_SECONDS=20
# Don't call the same number again within this many days
RECALL_AFTER_DAYS=30

# Where leads/bookings/opt-outs are saved. On Render, point this at a
# persistent disk (e.g. /var/data) so data survives redeploys.
DATA_DIR=./data
