# Copy this file to .env and fill in real values before deploying.

# --- Site basics ---
SITE_NAME="Steven Scale Solutions"
SITE_URL="https://stevenscalesolutions.com"
CURRENCY="JMD"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
SESSION_SECRET=change-this-to-a-long-random-string

# --- Payment provider ---
# "test" lets you try the whole flow (cart -> checkout -> receipt) with no
# real money moving, so you can demo the site before your Fygaro account is
# approved. Switch to "fygaro" once you have real credentials below.
PAYMENT_PROVIDER=test

# Fygaro (https://fygaro.com) — a Jamaican payment platform that supports
# local JMD/USD payouts, hosted checkout pages, and automatic receipts.
# After you open a Fygaro merchant account, get these from your Fygaro
# dashboard (Developer / API settings) and paste them here:
FYGARO_API_KEY=
FYGARO_API_SECRET=
FYGARO_WEBHOOK_SECRET=
# The base checkout link Fygaro gives you for creating hosted payments.
# Ask Fygaro support / check their developer docs for the exact endpoint;
# this is left blank on purpose until you have it. See lib/providers/fygaro.js.
FYGARO_API_BASE_URL=

# --- Email (for sending receipts to customers and to you) ---
# Any SMTP account works: Gmail app password, Zoho, Outlook, or your own
# domain email through your hosting/registrar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RECEIPT_FROM_EMAIL="Steven Scale Solutions <orders@stevenscalesolutions.com>"
# Where the business copy of every receipt gets sent:
BUSINESS_RECEIPT_EMAIL=steventravels876@gmail.com
